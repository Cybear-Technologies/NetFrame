{
  "name": "netframe-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "NetFrame — cyberpunk CSS library monorepo",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:browser": "pnpm --filter @netframe/docs run test:browser",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run test:browser",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run typecheck && pnpm run test && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "typescript": "^7.0.2"
  }
}
