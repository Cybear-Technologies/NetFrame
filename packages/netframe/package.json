{
  "name": "netframe",
  "version": "0.2.1",
  "description": "A cyberpunk-themed CSS component library",
  "type": "module",
  "license": "GPL-3.0-only",
  "author": "Cybear Technologies",
  "contributors": [
    "Jackson Chandler"
  ],
  "bugs": "https://github.com/Cybear-Technologies/NetFrame/issues",
  "keywords": [
    "css",
    "cyberpunk",
    "ui",
    "design-system",
    "sass",
    "scss"
  ],
  "homepage": "https://github.com/Cybear-Technologies/NetFrame#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cybear-Technologies/NetFrame.git",
    "directory": "packages/netframe"
  },
  "exports": {
    ".": {
      "style": "./dist/netframe.css",
      "sass": "./dist/scss/netframe.scss",
      "default": "./dist/netframe.css"
    },
    "./min": {
      "style": "./dist/netframe.min.css",
      "default": "./dist/netframe.min.css"
    },
    "./themes": {
      "style": "./dist/themes.css",
      "sass": "./dist/scss/themes/themes.scss",
      "default": "./dist/themes.css"
    },
    "./themes/min": {
      "style": "./dist/themes.min.css",
      "default": "./dist/themes.min.css"
    },
    "./scss/*": "./dist/scss/*",
    "./fonts/*": "./dist/fonts/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/netframe.css",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "lint": "stylelint \"src/**/*.scss\"",
    "dev": "tsx scripts/build.ts --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx scripts/build.ts && node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "autoprefixer": "^10.6.2",
    "cssnano": "^9.9.0",
    "postcss": "^8.5.33",
    "sass": "^1.108.2",
    "stylelint": "^18.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
