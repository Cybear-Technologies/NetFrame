import BaseLayout from '../layouts/BaseLayout.astro';
import SkipLink from '../components/SkipLink.astro';
---

<BaseLayout title="404 — Route not found" description="This NetFrame documentation route does not exist. Return to the docs or component reference.">
  <SkipLink />
  <main class="route-error nf-pixel-grid" id="main-content" tabindex="-1">
    <section class="error-console" aria-labelledby="error-title">
      <p class="error-channel">NETFRAME // ROUTE_DIAGNOSTICS</p>
      <div class="error-body">
        <p class="error-code" aria-hidden="true">404<span>_</span></p>
        <h1 id="error-title">SIGNAL LOST</h1>
        <p class="error-message">Page not found. This route is offline, moved, or never existed.</p>
        <p class="error-hint">Your session is intact. Choose a known endpoint to reconnect.</p>
        <nav class="error-actions" aria-label="Recovery navigation">
          <a class="nf-button nf-button-primary" href="/">RETURN HOME</a>
          <a class="nf-button nf-button-outline" href="/getting-started/">OPEN DOCS</a>
        </nav>
      </div>
      <p class="error-footer">STATUS: NOT_FOUND <span>// NO RETRY REQUIRED</span></p>
    </section>
  </main>
</BaseLayout>

<style>
  .route-error {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 5vw, 4rem);
  }

  .error-console {
    width: min(100%, 48rem);
    border: 2px solid var(--nf-color-primary);
    background: var(--nf-color-bg);
    box-shadow: 8px 8px 0 var(--nf-color-primary);
  }

  .error-channel,
  .error-footer {
    padding: var(--nf-space-3) var(--nf-space-5);
    font-family: var(--nf-font-mono);
    font-size: var(--nf-text-xs);
    letter-spacing: var(--nf-tracking-display);
  }

  .error-channel {
    color: var(--nf-color-on-primary);
    background: var(--nf-color-primary);
  }

  .error-body { padding: clamp(1.5rem, 5vw, 3.5rem); }

  .error-code {
    font-family: var(--nf-font-display);
    font-size: clamp(5rem, 18vw, 10rem);
    font-weight: var(--nf-font-weight-bold);
    line-height: 1;
    color: var(--nf-color-primary);
  }

  .error-code span { color: var(--nf-color-secondary); }

  h1 {
    margin-top: var(--nf-space-5);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    letter-spacing: var(--nf-tracking-display);
    color: var(--nf-color-text);
  }

  .error-message { margin-top: var(--nf-space-4); color: var(--nf-color-text); }
  .error-hint { margin-top: var(--nf-space-3); color: var(--nf-color-text-muted); }
  .error-actions { display: flex; flex-wrap: wrap; gap: var(--nf-space-4); margin-top: var(--nf-space-8); }
  .error-footer { border-top: 1px solid var(--nf-color-border); color: var(--nf-color-text-muted); }
  .error-footer span { display: inline-block; }
</style>
