---
// NetFrame — Base Layout
// Copyright (C) 2026 Cybear Technologies
// SPDX-License-Identifier: GPL-3.0-only

interface Props {
  title: string;
  description?: string | undefined;
}

// Phosphor Icons (thin weight), bundled locally instead of executing a CDN script.
import '@phosphor-icons/web/thin';

const { title, description = 'NetFrame — Cyberpunk CSS component library by Cybear Technologies' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title === 'Home' ? 'NETFRAME by Cybear Technologies' : `${title} // NETFRAME by Cybear Technologies`}</title>

    <!-- NetFrame CSS -->
    <link rel="stylesheet" href="/netframe.css" />
    <link rel="stylesheet" href="/themes.css" />

    <!-- Marks JS-capable browsers so the mobile nav can start closed without a flash,
         and applies the saved theme before first paint. Inline scripts cannot import
         modules: this is a copy of readTheme() from src/scripts/theme.ts. -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          var t = localStorage.getItem('nf-theme');
          if (t && /^nf-theme-[a-z0-9-]+$/.test(t)) document.documentElement.classList.add(t);
        } catch (e) {
          // Storage blocked: fall back to the default palette.
        }
      })();
    </script>
  </head>
  <body class="nf-crt">
    <slot />
  </body>
</html>
