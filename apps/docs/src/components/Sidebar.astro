---
// NetFrame — Sidebar navigation
// Copyright (C) 2026 Cybear Technologies
// SPDX-License-Identifier: GPL-3.0-only

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const nav = [
  {
    label: 'Getting Started',
    items: [
      { label: 'Introduction',     href: '/getting-started' },
      { label: 'Theming',          href: '/theming' },
      { label: 'Agents',           href: '/agents' },
    ],
  },
  {
    label: 'Components',
    items: [
      { label: 'Button',           href: '/components/button' },
      { label: 'Input',            href: '/components/input' },
      { label: 'Card',             href: '/components/card' },
      { label: 'Dropdown',         href: '/components/dropdown' },
      { label: 'Table',            href: '/components/table' },
      { label: 'Avatar',           href: '/components/avatar' },
      { label: 'Badge',            href: '/components/badge' },
      { label: 'Tag',              href: '/components/tag' },
      { label: 'Tooltip',          href: '/components/tooltip' },
      { label: 'Modal',            href: '/components/modal' },
      { label: 'Drawer',           href: '/components/drawer' },
      { label: 'Toast',            href: '/components/toast' },
      { label: 'Progress',         href: '/components/progress' },
      { label: 'Spinner',          href: '/components/spinner' },
      { label: 'Tabs',             href: '/components/tabs' },
      { label: 'Accordion',        href: '/components/accordion' },
      { label: 'Breadcrumb',       href: '/components/breadcrumb' },
      { label: 'Pagination',       href: '/components/pagination' },
      { label: 'Divider',          href: '/components/divider' },
      { label: 'Skeleton',         href: '/components/skeleton' },
    ],
  },
  {
    label: 'Utilities',
    items: [
      { label: 'Shadows & Glows',  href: '/utilities/glow' },
      { label: 'Scanlines',        href: '/utilities/scanlines' },
      { label: 'Glitch',           href: '/utilities/glitch' },
      { label: 'Layout',           href: '/utilities/layout' },
    ],
  },
];
---

<nav class="sidebar" id="docs-sidebar" aria-label="Documentation">
  <div class="sidebar-head">
    <a href="/" class="sidebar-logo">
      <span class="sidebar-logo-text">NET<span>FRAME</span></span>
      <span class="sidebar-logo-sub">BY CYBEAR TECHNOLOGIES</span>
    </a>
    <button type="button" class="sidebar-close" id="nav-close" aria-label="Close navigation menu">
      <i class="ph-thin ph-x" aria-hidden="true"></i>
      <span>CLOSE</span>
    </button>
  </div>

  <!-- Nav sections -->
  {nav.map((section) => (
    <div class="sidebar-section">
      <p class="sidebar-section-label">{section.label}</p>
      <ul class="sidebar-list">
        {section.items.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={currentPath === item.href || currentPath === item.href + '/' ? 'page' : undefined}
              class:list={[
                'sidebar-link',
                { 'sidebar-link-active': currentPath === item.href || currentPath === item.href + '/' }
              ]}
            >
              {item.label.toUpperCase()}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>

<style>
  /* Mobile first: below 64rem the sidebar is a drawer (see scripts/docs-nav.ts).
     Without JavaScript it stays a normal block above the content. */
  .sidebar {
    display: flex;
    flex-direction: column;
    background-color: var(--nf-color-bg);
    border-bottom: 2px solid var(--nf-color-primary);
    padding-bottom: env(safe-area-inset-bottom);
  }

  :global(html.js) .sidebar {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: var(--nf-z-modal);
    width: min(20rem, calc(100vw - 3rem));
    overflow-y: auto;
    overscroll-behavior: contain;
    border-bottom: none;
    border-right: 2px solid var(--nf-color-primary);
    padding-left: env(safe-area-inset-left);
    scrollbar-width: thin;
    scrollbar-color: var(--nf-color-border) transparent;
    transform: translateX(-100%);
    visibility: hidden;
    transition: transform var(--nf-duration-slow) var(--nf-ease-sharp),
                visibility 0s linear var(--nf-duration-slow);
  }

  :global(html.js) .sidebar[data-state='open'] {
    transform: none;
    visibility: visible;
    transition-delay: 0s;
  }

  @media (min-width: 64rem) {
    .sidebar,
    :global(html.js) .sidebar {
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      z-index: var(--nf-z-sticky);
      width: 16rem;
      overflow-y: auto;
      border-bottom: none;
      border-right: 2px solid var(--nf-color-primary);
      padding-left: 0;
      transform: none;
      visibility: visible;
      transition: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .sidebar { transition: none; }
  }

  .sidebar-head {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    border-bottom: 2px solid var(--nf-color-primary);
    flex-shrink: 0;
  }

  .sidebar-logo {
    display: flex;
    flex-direction: column;
    gap: var(--nf-space-1);
    padding: var(--nf-space-5) var(--nf-space-6);
    text-decoration: none;
    min-width: 0;
  }

  .sidebar-close {
    display: none;
    align-items: center;
    justify-content: center;
    gap: var(--nf-space-2);
    min-width: 2.75rem;
    min-height: 2.75rem;
    margin: var(--nf-space-3);
    padding: 0 var(--nf-space-3);
    align-self: flex-start;
    color: var(--nf-color-text);
    border: 2px solid var(--nf-color-border-strong);
    font-family: var(--nf-font-body);
    font-size: var(--nf-text-xs);
    letter-spacing: var(--nf-tracking-display);
    cursor: crosshair;

    &:hover { color: var(--nf-color-primary); border-color: var(--nf-color-primary); }
  }

  .sidebar-close i {
    font-size: 1.25rem;
    line-height: 1;
    color: inherit;
  }

  :global(html.js) .sidebar-close { display: inline-flex; }

  @media (min-width: 64rem) {
    :global(html.js) .sidebar-close { display: none; }
  }

  .sidebar-logo-text {
    font-family: var(--nf-font-display);
    font-size: var(--nf-text-2xl);
    font-weight: var(--nf-font-weight-bold);
    letter-spacing: var(--nf-tracking-display);
    color: var(--nf-color-text);
    line-height: 1;

    span { color: var(--nf-color-primary); }
  }

  .sidebar-logo-sub {
    font-family: var(--nf-font-label);
    font-size: var(--nf-text-base);
    letter-spacing: var(--nf-tracking-wide);
    line-height: 1.2;
    color: var(--nf-color-secondary);
  }

  .sidebar-section {
    padding: var(--nf-space-4) 0;
    border-bottom: 1px solid var(--nf-color-border);
  }

  .sidebar-section-label {
    font-family: var(--nf-font-body);
    font-weight: var(--nf-font-weight-medium);
    font-size: var(--nf-text-sm);
    letter-spacing: var(--nf-tracking-display);
    text-transform: uppercase;
    color: var(--nf-color-text-subtle);
    padding: 0 var(--nf-space-6) var(--nf-space-2);
    margin: 0;
  }

  .sidebar-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: var(--nf-space-2) var(--nf-space-6);
    font-family: var(--nf-font-body);
    font-size: var(--nf-text-sm);
    letter-spacing: var(--nf-tracking-wide);
    color: var(--nf-color-text);
    text-decoration: none;
    transition: color var(--nf-duration-fast) var(--nf-ease-sharp),
                background-color var(--nf-duration-fast) var(--nf-ease-sharp);

    &:hover {
      color: var(--nf-color-primary);
      background-color: color-mix(in srgb, var(--nf-color-primary) 5%, transparent);
    }
  }

  .sidebar-link-active {
    color: var(--nf-color-primary);
    border-left: 2px solid var(--nf-color-primary);
    padding-left: calc(var(--nf-space-6) - 2px);
    background-color: color-mix(in srgb, var(--nf-color-primary) 5%, transparent);
  }
</style>
