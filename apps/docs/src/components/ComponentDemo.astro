---
// NetFrame — Component Demo block
// Renders a live preview + copy-able code block side by side (or stacked).

interface Props {
  title?: string;
  code: string;
  stacked?: boolean;
}

const { title, code, stacked = false } = Astro.props;
---

<div class="demo-wrap">
  {title && <p class="demo-label">{title.toUpperCase()}</p>}

  <div class:list={['demo-inner', { 'demo-stacked': stacked }]}>
    <!-- Live preview -->
    <div class="demo-preview nf-pixel-grid-subtle">
      <slot />
    </div>

    <!-- Code block -->
    <div class="demo-code-wrap">
      <div class="demo-code-bar">
        <button type="button" class="demo-copy" data-code={code} aria-label="Copy code">
          <i class="ph-thin ph-copy" aria-hidden="true"></i>
          <span class="demo-copy-label">COPY</span>
        </button>
        <span class="demo-copy-status nf-sr-only" role="status" aria-live="polite"></span>
      </div>
      <!-- tabindex: keyboard users must be able to scroll long examples -->
      <pre class="demo-code" tabindex="0" aria-label={title ? `${title} code` : 'Example code'}><code>{code}</code></pre>
    </div>
  </div>
</div>

<script>
  const RESET_MS = 1500;

  async function copyText(text: string): Promise<boolean> {
    try {
      if (!navigator.clipboard?.writeText) return false;
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // Permission denied, insecure context, or document not focused.
      return false;
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.demo-copy').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('.demo-copy-label');
    const status = btn.parentElement?.querySelector<HTMLElement>('.demo-copy-status');
    let timer: number | undefined;

    btn.addEventListener('click', async () => {
      const ok = await copyText(btn.dataset['code'] ?? '');
      const message = ok ? 'COPIED' : 'COPY FAILED';
      if (label) label.textContent = message;
      if (status) status.textContent = ok ? 'Code copied to clipboard' : 'Copy failed';
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (label) label.textContent = 'COPY';
        if (status) status.textContent = '';
      }, RESET_MS);
    });
  });
</script>

<style>
  .demo-wrap {
    margin-block: var(--nf-space-6);
    border: 2px solid var(--nf-color-border);
  }

  .demo-label {
    font-family: var(--nf-font-body);
    font-weight: var(--nf-font-weight-medium);
    font-size: var(--nf-text-sm);
    letter-spacing: var(--nf-tracking-display);
    color: var(--nf-color-text-subtle);
    background-color: var(--nf-color-surface-lowest);
    padding: var(--nf-space-1) var(--nf-space-4);
    margin: 0;
    border-bottom: 1px solid var(--nf-color-border);
  }

  .demo-inner {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);

    @media (max-width: 72rem) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .demo-stacked {
    grid-template-columns: 1fr;
  }

  .demo-preview {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--nf-space-4);
    padding: var(--nf-space-8);
    border-right: 1px solid var(--nf-color-border);
    min-height: 8rem;

    @media (max-width: 72rem) {
      border-right: none;
      border-bottom: 1px solid var(--nf-color-border);
    }
  }

  .demo-stacked .demo-preview {
    border-right: none;
    border-bottom: 1px solid var(--nf-color-border);
  }

  .demo-code-wrap {
    min-width: 0;
    background-color: var(--nf-color-surface-lowest);
    display: flex;
    flex-direction: column;
  }

  .demo-code-bar {
    display: flex;
    justify-content: flex-end;
    padding: var(--nf-space-2) var(--nf-space-3);
    border-bottom: 1px solid var(--nf-color-border);
    flex-shrink: 0;
  }

  .demo-copy {
    display: inline-flex;
    align-items: center;
    gap: var(--nf-space-1);
    padding: var(--nf-space-1) var(--nf-space-2);
    font-family: var(--nf-font-body);
    font-weight: var(--nf-font-weight-medium);
    font-size: var(--nf-text-sm);
    letter-spacing: var(--nf-tracking-display);
    color: var(--nf-color-text-muted);
    background: none;
    border: 1px solid var(--nf-color-border);
    cursor: crosshair;
    transition: color var(--nf-duration-fast) var(--nf-ease-sharp),
                border-color var(--nf-duration-fast) var(--nf-ease-sharp);

    &:hover {
      color: var(--nf-color-primary);
      border-color: var(--nf-color-primary);
    }
  }

  .demo-code {
    margin: 0;
    padding: var(--nf-space-5);
    font-family: var(--nf-font-mono);
    font-size: var(--nf-text-sm);
    color: var(--nf-color-text-muted);
    overflow-x: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    background: none;
    border: none;
  }
</style>
